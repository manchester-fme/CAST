{
  "coverage": {
    "repo_url": "https://github.com/Z3Prover/z3.git",
    "extra_repos": ["https://github.com/z3prover/z3test.git"],
    "pre_discovery_setup": null,
    "discovery_flag": "--z3test-dir",
    "discovery_target": "z3test",
    "oracle_solver": "cvc5",
    "oracle_fetch": {
      "type": "script",
      "path": "src/solvers/download_cvc5.py",
      "install_dir": "$HOME/.local/bin"
    }
  },
  "fuzzer": {
    "repo_url": "https://github.com/Z3Prover/z3.git",
    "extra_repos": ["https://github.com/z3prover/z3test.git"],
    "extra_pip_packages": ["requests"],
    "tests_root": "../z3test",
    "target_flag": "--z3-path",
    "target_binary_path": "./build/z3",
    "oracle_solver": "cvc5",
    "oracle_flag": "--cvc5-path",
    "oracle_fetch_fallback": {
      "type": "script",
      "path": "src/solvers/download_cvc5.py"
    },
    "skip_sut_clone_if_binary_cached": true,
    "git_cleanup_dirs": ["z3test", "yinyang"]
  }
}
